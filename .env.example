# Art Context Engine — environment
#
# Copy to `.env` and fill in. Everything here is read once at process start
# (except the Stripe keys, which are read per call so a restart is not needed
# to disable billing).
#
# Production refuses to boot with an unsafe combination of these values; see
# `src/config.py::production_problems`.

# ── runtime ────────────────────────────────────────────────────────────────
# development | production. `production` enables the fail-fast checks.
ACE_ENV=development

# Where bytes come from: fixture | live | auto. Tests and the evaluation suite
# pin `fixture` themselves; `auto` is convenient locally and wrong for CI.
ACE_HTTP=auto

# Public origin. Must be https in production: it is used for Stripe return
# URLs, sign-in links and the Secure flag on cookies.
ACE_BASE_URL=http://localhost:8000

# Host header allowlist. Name your real domain in production; never '*'.
ACE_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to 1 only when a reverse proxy terminates TLS in front of uvicorn, so
# X-Forwarded-For is trusted for rate limiting.
ACE_TRUST_PROXY=0

# ── security ───────────────────────────────────────────────────────────────
# Required in production (>= 32 random chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ACE_SESSION_SECRET=

# 1 = sign-in requires a mailed link that proves the address. Never disable on
# an install that takes payments: without it, typing a customer's email is
# enough to inherit their plan. Refused by the production checks with Stripe on.
ACE_REQUIRE_EMAIL_VERIFICATION=1
# Local development without SMTP: set to 0 to sign in directly.
# ACE_REQUIRE_EMAIL_VERIFICATION=0

ACE_MAX_BODY_BYTES=262144
ACE_RATE_LIMIT=20
ACE_SIGNIN_RATE_LIMIT=5
ACE_FREE_QUOTA=5
ACE_ANON_QUOTA=2

# ── mail (sign-in links) ───────────────────────────────────────────────────
ACE_SMTP_HOST=
ACE_SMTP_PORT=587
ACE_SMTP_USER=
ACE_SMTP_PASSWORD=
ACE_MAIL_FROM=no-reply@example.org

# ── payments ───────────────────────────────────────────────────────────────
# Without STRIPE_SECRET_KEY the app runs free: every feature, no quota.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the Stripe dashboard webhook endpoint (see README for the URL).
STRIPE_WEBHOOK_SECRET=
# Price id of the Pro subscription (price_..., not prod_...).
STRIPE_PRICE_PRO=
ACE_PRO_PRICE_DISPLAY=€9 / month

# ── optional ───────────────────────────────────────────────────────────────
ACE_JURISDICTION=US
ACE_LLM=0
ACE_LLM_BASE_URL=
